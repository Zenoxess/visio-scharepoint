{
  "SchemaVersion": "1.0",
  "ResolvedDecisionIds": [
    "ENV-001", "ENV-002", "ENV-003", "SRC-001", "SRC-002",
    "CNV-001", "CNV-002", "SP-001", "SP-002", "SEC-001",
    "SEC-002", "SYN-001", "SYN-002", "SYN-003", "SYN-005",
    "OPS-001", "ACC-001", "ACC-003"
  ],
  "Source": {
    "RootPath": "\\\\fileserver.example.invalid\\drawings",
    "FileNamePattern": "^PPSI-.*\\.(vsd|vsdx|vsdm)$",
    "Extensions": [
      ".vsd",
      ".vsdx",
      ".vsdm"
    ],
    "RegexTimeoutMilliseconds": 500
  },
  "Conversion": {
    "Provider": "VisioCom",
    "OutputFormat": "PDF",
    "PageRange": "AllForegroundPages",
    "Intent": "Print",
    "DisableMacros": true,
    "RefreshExternalData": false
  },
  "SharePoint": {
    "Platform": "SharePointOnline",
    "ApiKind": "MicrosoftGraphV1",
    "AuthenticationKind": "CertificateAppOnly",
    "CertificateStoreLocation": "LocalMachine",
    "WorkloadIdentityFilePath": null,
    "TenantId": "11111111-1111-4111-8111-111111111111",
    "ClientId": "22222222-2222-4222-8222-222222222222",
    "CertificateThumbprint": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
    "SiteId": "example.sharepoint.com,33333333-3333-4333-8333-333333333333,44444444-4444-4444-8444-444444444444",
    "DriveId": "b!dummy-drive-id",
    "TargetFolderId": "01DUMMYTARGETFOLDERID",
    "SiteUrl": null,
    "LibraryName": null,
    "TargetFolderPath": null
  },
  "Sync": {
    "Direction": "PublishOnly",
    "ConflictPolicy": "SourceWins",
    "RenamePolicy": "CreateNew",
    "DeletePolicy": "Never",
    "FingerprintMode": "MetadataThenSha256"
  },
  "Operations": {
    "StatePath": "C:\\ProgramData\\VisioSharePointSync\\state.json",
    "StagingPath": "C:\\ProgramData\\VisioSharePointSync\\staging",
    "LogPath": "C:\\ProgramData\\VisioSharePointSync\\logs",
    "IntervalMinutes": 15,
    "StabilityProbeSeconds": 10,
    "ConversionTimeoutSeconds": 300,
    "MaxRetryCount": 3,
    "SingleHostOnly": true
  }
}
